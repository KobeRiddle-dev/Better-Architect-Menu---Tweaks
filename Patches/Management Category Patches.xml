<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Manage > Management -->
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>RenameManagementCategory</id>
        <defaultValue>True</defaultValue>
        <label>Rename to Management. (Default: True)</label>
        <tooltip>Rename the Manage Category to Management.</tooltip>
        <category>KobeRiddle_ManagementCategory</category>
        <order>000</order>

        <operations>

            <li Class="PatchOperationReplace">
                <xpath>Defs/DesignationCategoryDef[defName="Ferny_Colony"]/label</xpath>
                <value>
                    <label>Management</label>
                </value>
            </li>

        </operations>

    </Operation>

</Patch>