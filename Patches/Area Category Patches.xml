<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>CombineTemperatureSubcategories</id>
        <defaultValue>True</defaultValue>
        <label>Combine Temperature Subcategories. (Default: True)</label>
        <tooltip>Combines Heating, Cooling, and Airflow into a new Temperature subcategory.</tooltip>
        <category>KobeRiddle_AreaCategory</category>
        <order>000</order>

        <operations>

            <!-- Move everything in Heating, Cooling, and Airflow to a new Temperature Category -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[designationCategory="Ferny_Heating" or designationCategory="Ferny_Cooling" or designationCategory="Ferny_AirManagement"]/designationCategory</xpath>
                <value>
                    <designationCategory>Ferny_Temperature</designationCategory>
                </value>
            </li>

        </operations>

    </Operation>

    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>CombineFilthAndPollution</id>
        <defaultValue>True</defaultValue>
        <label>Combine Filth and Pollution. (Default: True)</label>
        <tooltip>Moves everything from Area/Filth into Area/Pollution.</tooltip>
        <category>KobeRiddle_AreaCategory</category>
        <order>100</order>

        <operations>

            <!-- Move everything in Filth to Pollution -->
            <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[designationCategory="Ferny_Filth"]/designationCategory</xpath>

                <match Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[designationCategory="Ferny_Filth"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Pollution</designationCategory>
                    </value>
                </match>
            </li>
        </operations>

    </Operation>

    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>RemoveTerraforming</id>
        <defaultValue>True</defaultValue>
        <label>Remove Terraforming Subcategory. (Default: True)</label>
        <tooltip>Moves everything from Area/Terraforming into Area/Other</tooltip>
        <category>KobeRiddle_AreaCategory</category>
        <order>200</order>

        <operations>

            <!-- Move everything in Terraforming to Area/Other -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[designationCategory="Ferny_Terraforming"]/designationCategory</xpath>
                <value>
                    <designationCategory>Temperature</designationCategory>
                </value>
            </li>

        </operations>

    </Operation>

</Patch>