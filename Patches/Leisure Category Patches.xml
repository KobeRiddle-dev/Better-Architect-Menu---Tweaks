<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Entertain > Leisure -->
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>RenameLeisureCategory</id>
        <defaultValue>True</defaultValue>
        <label>Rename to Leisure. (Default: True)</label>
        <tooltip>Rename the Entertain Category to Furniture.</tooltip>
        <category>KobeRiddle_LeisureCategory</category>
        <order>000</order>

        <operations>

            <li Class="PatchOperationReplace">
                <xpath>Defs/DesignationCategoryDef[defName="Ferny_Hosting"]/label</xpath>
                <value>
                    <label>Leisure</label>
                </value>
            </li>

        </operations>

    </Operation>

</Patch>