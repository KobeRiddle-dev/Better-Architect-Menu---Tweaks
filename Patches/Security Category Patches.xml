<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <id>RenameSecurityCategory</id>
        <defaultValue>True</defaultValue>
        <label>Rename to Security. (Default: True)</label>
        <tooltip>Rename the Fight category to Security.</tooltip>
        <category>KobeRiddle_SecurityCategory</category>
        <order>000</order>

        <operations>
            <li Class="PatchOperationReplace">
                <xpath>Defs/DesignationCategoryDef[defName="Security"]/label</xpath>
                <value>
                    <label>Security</label>
                </value>
            </li>
        </operations>
    </Operation>

</Patch>