    </Operation>

    <!-- Process > Processing -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/DesignationCategoryDef[defName="Ferny_ProcessingProduction"]/label</xpath>
        <value>
            <label>Processing</label>
        </value>
    </Operation>

</Patch>